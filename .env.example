# Optional defaults for Ollama before any settings have been saved.
# Copy this file to .env.local only if you want to override these defaults.
# Saved values in ~/.matalai/settings.json take precedence.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Chat and voice providers, URLs, profiles, and API keys are configured
# in the app's Settings screen. Do not put real credentials in this file.
